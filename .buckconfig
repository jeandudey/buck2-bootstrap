[cells]
  root = .
  prelude = prelude
  none = none
  toolchains = toolchains

[external_cells]
  prelude = bundled

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[parser]
  target_platform_detector_spec = target:root//...->root//platforms:linux-x86_64

[build]
  execution_platforms = root//platforms:default
