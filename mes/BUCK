load(
    "//stage0:defs.bzl",
    "bootstrap_blood_elf",
    "bootstrap_hex2_link",
    "bootstrap_m1_assemble",
    "bootstrap_m2_compile",
)
load(
    ":defs.bzl",
    "ARCHITECTURE",
    "BASE_ADDRESS",
    "COMPATIBLE_WITH",
    "CPU_DEFINES",
    "ELF_HEADER",
    "LIBC_M1",
    "MES_VERSION",
    "SOURCES",
    "WORD_SIZE",
    "mes_config_h",
)

# Generated by configure.sh upstream, which we do not run.
mes_config_h(
    name = "config.h",
    version = MES_VERSION,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_m2_compile(
    name = "mes.m1",
    compiler = "//stage0:m2_stage1",
    architecture = ARCHITECTURE,
    debug = True,
    defines = CPU_DEFINES + ["__linux__=1"],
    srcs = [":config.h"] + SOURCES,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_blood_elf(
    name = "mes_footer.m1",
    blood_elf = "//stage0:blood_elf_stage1",
    src = ":mes.m1",
    word_size = WORD_SIZE,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_m1_assemble(
    name = "mes.hex2",
    assembler = "//stage0:m1_stage1",
    architecture = ARCHITECTURE,
    srcs = LIBC_M1 + [
        ":mes.m1",
        ":mes_footer.m1",
    ],
    target_compatible_with = COMPATIBLE_WITH,
)

# The Scheme interpreter, built by M2-Planet rather than by MesCC.
bootstrap_hex2_link(
    name = "mes_m2",
    linker = "//stage0:hex2_stage2",
    architecture = ARCHITECTURE,
    base_address = BASE_ADDRESS,
    srcs = ELF_HEADER + [":mes.hex2"],
    target_compatible_with = COMPATIBLE_WITH,
    visibility = ["PUBLIC"],
)
