load(
    "//stage0:defs.bzl",
    "bootstrap_blood_elf",
    "bootstrap_hex2_link",
    "bootstrap_m1_assemble",
    "bootstrap_m2_compile",
    "bootstrap_source_tree",
    "bootstrap_subst",
)
load(
    ":defs.bzl",
    "ARCH_M1",
    "ARCHITECTURE",
    "BASE_ADDRESS",
    "COMPATIBLE_WITH",
    "CPU_DEFINES",
    "CRT1",
    "ELF_HEADER",
    "LIBC_M1",
    "MESCC_SUBSTITUTIONS",
    "MES_VERSION",
    "SOURCES",
    "WORD_SIZE",
    "mes_config_h",
    "mescc",
    "mescc_compile",
)

# Generated by configure.sh upstream, which we do not run.
mes_config_h(
    name = "config.h",
    version = MES_VERSION,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_m2_compile(
    name = "mes.m1",
    compiler = "//stage0:m2_stage1",
    architecture = ARCHITECTURE,
    debug = True,
    defines = CPU_DEFINES + ["__linux__=1"],
    srcs = [":config.h"] + SOURCES,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_blood_elf(
    name = "mes_footer.m1",
    blood_elf = "//stage0:blood_elf_stage1",
    src = ":mes.m1",
    word_size = WORD_SIZE,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_m1_assemble(
    name = "mes.hex2",
    assembler = "//stage0:m1_stage1",
    architecture = ARCHITECTURE,
    srcs = LIBC_M1 + [
        ":mes.m1",
        ":mes_footer.m1",
    ],
    target_compatible_with = COMPATIBLE_WITH,
)

# The Scheme interpreter, built by M2-Planet rather than by MesCC.
bootstrap_hex2_link(
    name = "mes_m2",
    linker = "//stage0:hex2_stage2",
    architecture = ARCHITECTURE,
    base_address = BASE_ADDRESS,
    srcs = ELF_HEADER + [":mes.hex2"],
    target_compatible_with = COMPATIBLE_WITH,
    visibility = ["PUBLIC"],
)

# Where Mes looks for boot-5.scm, and the (mes ...) modules.
bootstrap_source_tree(
    name = "mes_prefix",
    srcs = glob(["src/mes/module/**"]),
    strip_prefix = "src/",
)

# The (mescc ...) modules, the compiler proper.
bootstrap_source_tree(
    name = "modules",
    srcs = glob(["src/module/**"]),
    strip_prefix = "src/module/",
)

bootstrap_source_tree(
    name = "include",
    srcs = glob(["src/include/**"]),
    strip_prefix = "src/include/",
)

# configure.sh writes config.h into the build tree's include directory, which
# is searched ahead of the one in the sources.
bootstrap_source_tree(
    name = "config_include",
    extra = {"mes/config.h": ":config.h"},
)

bootstrap_subst(
    name = "mescc.scm",
    src = "src/scripts/mescc.scm.in",
    replace = "//stage0:replace_stage0",
    substitutions = MESCC_SUBSTITUTIONS,
    target_compatible_with = COMPATIBLE_WITH,
)

mescc(
    name = "mescc",
    mes = ":mes_m2",
    script = ":mescc.scm",
    mes_prefix = ":mes_prefix",
    modules = ":modules",
    nyacc = "//nyacc:modules",
    includes = [
        ":config_include",
        ":include",
    ],
    target_compatible_with = COMPATIBLE_WITH,
    visibility = ["PUBLIC"],
)

# The first piece of the Mes C library compiled by MesCC: the start files.
mescc_compile(
    name = "crt1.s",
    mescc = ":mescc",
    src = CRT1,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_m1_assemble(
    name = "crt1.o",
    assembler = "//stage0:m1_stage1",
    architecture = ARCHITECTURE,
    srcs = ARCH_M1 + [":crt1.s"],
    target_compatible_with = COMPATIBLE_WITH,
    visibility = ["PUBLIC"],
)
