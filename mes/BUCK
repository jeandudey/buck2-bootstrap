load(
    "//stage0:defs.bzl",
    "bootstrap_blood_elf",
    "bootstrap_hex2_link",
    "bootstrap_m1_assemble",
    "bootstrap_m2_compile",
    "bootstrap_source_tree",
    "bootstrap_subst",
)
load(
    ":defs.bzl",
    "ARCHITECTURE",
    "BASE_ADDRESS",
    "COMPATIBLE_WITH",
    "CPU_DEFINES",
    "CONFIG_INCLUDE",
    "CRT1",
    "ELF_HEADER",
    "ELF_LINK_FOOTER",
    "ELF_LINK_HEADER",
    "LIBC_MINI_OBJECTS",
    "LIBC_OBJECTS",
    "LIBMESCC_OBJECTS",
    "LIBC_M1",
    "MESCC_SOURCES",
    "MESCC_SUBSTITUTIONS",
    "MES_OBJECTS",
    "MES_VERSION",
    "SOURCES",
    "WORD_SIZE",
    "mes_config_h",
    "mescc",
    "mescc_archive",
    "mescc_object",
    "mescc_objects",
)

# Generated by configure.sh upstream, which we do not run.
mes_config_h(
    name = "config.h",
    version = MES_VERSION,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_m2_compile(
    name = "mes.m1",
    compiler = "//stage0:m2_stage1",
    architecture = ARCHITECTURE,
    debug = True,
    defines = CPU_DEFINES + ["__linux__=1"],
    srcs = [":config.h"] + SOURCES,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_blood_elf(
    name = "mes_footer.m1",
    blood_elf = "//stage0:blood_elf_stage1",
    src = ":mes.m1",
    word_size = WORD_SIZE,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_m1_assemble(
    name = "mes.hex2",
    assembler = "//stage0:m1_stage1",
    architecture = ARCHITECTURE,
    srcs = LIBC_M1 + [
        ":mes.m1",
        ":mes_footer.m1",
    ],
    target_compatible_with = COMPATIBLE_WITH,
)

# The Scheme interpreter, built by M2-Planet rather than by MesCC.
bootstrap_hex2_link(
    name = "mes_m2",
    linker = "//stage0:hex2_stage2",
    architecture = ARCHITECTURE,
    base_address = BASE_ADDRESS,
    srcs = ELF_HEADER + [":mes.hex2"],
    target_compatible_with = COMPATIBLE_WITH,
    visibility = ["PUBLIC"],
)

# Where Mes looks for boot-5.scm, and the (mes ...) modules.
bootstrap_source_tree(
    name = "mes_prefix",
    srcs = glob(["src/mes/module/**"]),
    strip_prefix = "src/",
)

# The (mescc ...) modules, the compiler proper.
bootstrap_source_tree(
    name = "modules",
    srcs = glob(["src/module/**"]),
    strip_prefix = "src/module/",
)

bootstrap_source_tree(
    name = "include",
    srcs = glob(["src/include/**"]),
    strip_prefix = "src/include/",
)

# configure.sh writes config.h into the build tree's include directory, which
# is searched ahead of the one in the sources.
bootstrap_source_tree(
    name = "config_include",
    extra = CONFIG_INCLUDE,
    target_compatible_with = COMPATIBLE_WITH,
)

bootstrap_subst(
    name = "mescc.scm",
    src = "src/scripts/mescc.scm.in",
    replace = "//stage0:replace_stage0",
    substitutions = MESCC_SUBSTITUTIONS,
    target_compatible_with = COMPATIBLE_WITH,
)

mescc(
    name = "mescc",
    mes = ":mes_m2",
    script = ":mescc.scm",
    mes_prefix = ":mes_prefix",
    modules = ":modules",
    nyacc = "//nyacc:modules",
    includes = [
        ":config_include",
        ":include",
    ],
    target_compatible_with = COMPATIBLE_WITH,
    visibility = ["PUBLIC"],
)

# The start files, and every object of the C library and of Mes itself.
mescc_object(
    name = "crt1",
    mescc = ":mescc",
    assembler = "//stage0:m1_stage1",
    src = CRT1,
)

mescc_objects(
    mescc = ":mescc",
    assembler = "//stage0:m1_stage1",
    sources = {
        name: src
        for name, src in MESCC_SOURCES.items()
        if name not in MES_OBJECTS
    },
)

# builtins.c and posix.c include a sibling source, which MesCC finds next to
# them rather than on the include path.
mescc_objects(
    mescc = ":mescc",
    assembler = "//stage0:m1_stage1",
    sources = {
        name: src
        for name, src in MESCC_SOURCES.items()
        if name in MES_OBJECTS
    },
    headers = glob(["src/src/*.c"]),
)

mescc_archive(
    name = "libc-mini",
    catm = "//stage0:catm_stage1",
    objects = LIBC_MINI_OBJECTS,
)

mescc_archive(
    name = "libmescc",
    catm = "//stage0:catm_stage1",
    objects = LIBMESCC_OBJECTS,
)

mescc_archive(
    name = "libc",
    catm = "//stage0:catm_stage1",
    objects = LIBC_OBJECTS,
)

# Mes built by MesCC rather than by M2-Planet: upstream's bin/mes-mescc, which
# it then installs as bin/mes.
bootstrap_hex2_link(
    name = "mes_mescc",
    linker = "//stage0:hex2_stage2",
    architecture = ARCHITECTURE,
    base_address = BASE_ADDRESS,
    srcs = ELF_LINK_HEADER + [":crt1.o"] + [
        ":" + o + ".o"
        for o in MES_OBJECTS
    ] + [
        ":libc.a",
        ":libmescc.a",
    ] + ELF_LINK_FOOTER,
    target_compatible_with = COMPATIBLE_WITH,
    visibility = ["PUBLIC"],
)
