    "ANSWERS_PREFIX",
    "BLOOD_ELF_SOURCES",
    "BOOTSTRAP_C",
    "ELF_HEADER",
    "GET_MACHINE_SOURCES",
    "HEX2_SOURCES",
    "KAEM_SOURCES",
    "M1_SOURCES",
    "M2_ARCHITECTURE",
    "M2_MESOPLANET_SOURCES",
    "M2_PLANET_SOURCES",
    "MESCC_TOOLS_EXTRA",
    "STAGE0_DEFS_LIBC",
    "bootstrap_cc_compile",
    "bootstrap_concat_file",
    "bootstrap_hex_assemble",
    "bootstrap_hex_prebuilt",
    "bootstrap_hex2_image",
    "bootstrap_m0_assemble",
    "bootstrap_m0_program",
    "bootstrap_m1_program",
    "bootstrap_m2_mesoplanet_compile",
    "bootstrap_sha256_check",
    "cpu_select",
    "stage0_path",
    "stage0_paths",
)

bootstrap_hex_prebuilt(
    name = "hex0_prebuilt",
    hex = stage0_path("bootstrap-seeds/POSIX/{arch}/hex0-seed"),
)

bootstrap_hex_assemble(
    name = "hex0_stage0",
    assembler = ":hex0_prebuilt",
    src = stage0_path("bootstrap-seeds/POSIX/{arch}/hex0_{arch}.hex0"),
)

bootstrap_hex_assemble(
    name = "hex1_stage0",
    assembler = ":hex0_stage0",
    src = stage0_path("{arch}/hex1_{arch}.hex0"),
)

bootstrap_hex_assemble(
    name = "hex2_stage0",
    assembler = ":hex1_stage0",
    src = stage0_path("{arch}/hex2_{arch}.hex1"),
)

bootstrap_hex_assemble(
    name = "catm_stage0",
    assembler = select({
        "prelude//cpu/constraints:cpu[arm64]": ":hex1_stage0",
        "DEFAULT": ":hex2_stage0",
    }),
    src = cpu_select(
        aarch64 = "src/AArch64/catm_AArch64.hex1",
        x86 = "src/x86/catm_x86.hex2",
        amd64 = "src/AMD64/catm_AMD64.hex2",
        riscv64 = "src/riscv64/catm_riscv64.hex2",
    ),
)

bootstrap_hex2_image(
    name = "m0_stage0",
    catm = ":catm_stage0",
    hex = ":hex2_stage0",
    srcs = stage0_paths("{arch}/M0_{arch}.hex2"),
    elf_header = ELF_HEADER,
)

bootstrap_concat_file(
    name = "cc_stage0_riscv64.m1",
    catm = ":catm_stage0",
    srcs = [
        "src/riscv64/riscv64_defs.M1",
        "src/riscv64/cc_riscv64.M1",
    ],
)

bootstrap_m0_assemble(
    name = "cc_stage0_no_elf_header.hex2",
    assembler = ":m0_stage0",
    src = cpu_select(
        aarch64 = "src/AArch64/cc_aarch64.M1",
        x86 = "src/x86/cc_x86.M1",
        amd64 = "src/AMD64/cc_amd64.M1",
        riscv64 = ":cc_stage0_riscv64.m1",
    ),
)

bootstrap_hex2_image(
    name = "cc_stage0",
    catm = ":catm_stage0",
    hex = ":hex2_stage0",
    srcs = [":cc_stage0_no_elf_header.hex2"],
    elf_header = ELF_HEADER,
)

bootstrap_concat_file(
    name = "m2_stage0.c",
    catm = ":catm_stage0",
    srcs = BOOTSTRAP_C + [
        "src/M2-Planet/cc.h",
        "src/M2libc/bootstrappable.c",
        "src/M2-Planet/cc_globals.c",
        "src/M2-Planet/cc_reader.c",
        "src/M2-Planet/cc_strings.c",
        "src/M2-Planet/cc_types.c",
        "src/M2-Planet/cc_emit.c",
        "src/M2-Planet/cc_core.c",
        "src/M2-Planet/cc_macro.c",
        "src/M2-Planet/cc.c",
    ],
)

bootstrap_cc_compile(
    name = "m2_stage0_no_defs_no_libc.m1",
    compiler = ":cc_stage0",
    src = ":m2_stage0.c",
)

bootstrap_concat_file(
    name = "m2_stage0.m1",
    catm = ":catm_stage0",
    srcs = STAGE0_DEFS_LIBC + [":m2_stage0_no_defs_no_libc.m1"],
)

bootstrap_m0_assemble(
    name = "m2_stage0_no_elf_header.hex2",
    assembler = ":m0_stage0",
    src = ":m2_stage0.m1",
)

bootstrap_hex2_image(
    name = "m2_stage0",
    catm = ":catm_stage0",
    hex = ":hex2_stage0",
    srcs = [":m2_stage0_no_elf_header.hex2"],
    elf_header = ELF_HEADER,
)

bootstrap_m0_program(
    name = "blood_elf_stage0",
    compiler = ":m2_stage0",
    assembler = ":m0_stage0",
    catm = ":catm_stage0",
    hex = ":hex2_stage0",
    bootstrap_mode = True,
    srcs = BOOTSTRAP_C + [
        "src/M2libc/bootstrappable.c",
        "src/mescc-tools/stringify.c",
        "src/mescc-tools/blood-elf.c",
    ],
)

bootstrap_m0_program(
    name = "m1_stage0",
    compiler = ":m2_stage0",
    assembler = ":m0_stage0",
    catm = ":catm_stage0",
    hex = ":hex2_stage0",
    blood_elf = ":blood_elf_stage0",
    bootstrap_mode = True,
    debug = True,
    srcs = BOOTSTRAP_C + [
        "src/M2libc/bootstrappable.c",
        "src/mescc-tools/stringify.c",
        "src/mescc-tools/M1-macro.c",
    ],
)

