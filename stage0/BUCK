load("@prelude//utils:selects.bzl", "selects")
load("//common:defs.bzl", "filegroup_strip_prefix")
load(
    ":defs.bzl",
    "ANSWERS",
    "ANSWERS_PREFIX",
    "BLOOD_ELF_SOURCES",
    "BOOTSTRAP_C",
    "GET_MACHINE_SOURCES",
    "HEX2_SOURCES",
    "KAEM_SOURCES",
    "M1_SOURCES",
    "M2_ARCHITECTURE",
    "M2LIBC_DEFS_LIBC",
    "M2LIBC_DEFS_LIBC_FULL",
    "M2LIBC_ELF_HEADER",
    "M2LIBC_ELF_HEADER_DEBUG",
    "M2_MESOPLANET_SOURCES",
    "M2_PLANET_SOURCES",
    "MESCC_TOOLS_EXTRA",
    "STAGE0_DEFS_LIBC",
    "bootstrap_cc_compile",
    "bootstrap_concat_file",
    "bootstrap_m0_assemble",
    "bootstrap_m2_mesoplanet_compile",
    "bootstrap_seed",
    "bootstrap_sha256_check",
    "hex2_binary",
    "hex_binary",
    "m0_binary",
    "m1_binary",
    "stage0_paths",
)

# The architecture, as stage0-posix spells it in directory and file names.
STAGE0_ARCH = select({
    "prelude//cpu/constraints:cpu[arm64]": "AArch64",
    "prelude//cpu/constraints:cpu[x86_32]": "x86",
    "prelude//cpu/constraints:cpu[x86_64]": "AMD64",
    "prelude//cpu/constraints:cpu[riscv64]": "riscv64",
})

bootstrap_seed(
    name = "hex0_seed",
    src = selects.apply(STAGE0_ARCH, lambda arch: "src/bootstrap-seeds/POSIX/{}/hex0-seed".format(arch)),
)

hex_binary(
    name = "hex0_stage0",
    assembler = ":hex0_seed",
    src = selects.apply(STAGE0_ARCH, lambda arch: "src/bootstrap-seeds/POSIX/{0}/hex0_{0}.hex0".format(arch)),
)

hex_binary(
    name = "hex1_stage0",
    assembler = ":hex0_stage0",
    src = selects.apply(STAGE0_ARCH, lambda arch: "src/{0}/hex1_{0}.hex0".format(arch)),
)

hex_binary(
    name = "hex2_stage0",
    assembler = ":hex1_stage0",
    src = selects.apply(STAGE0_ARCH, lambda arch: "src/{0}/hex2_{0}.hex1".format(arch)),
)

hex_binary(
    name = "catm_stage0",
    assembler = select({
        "prelude//cpu/constraints:cpu[arm64]": ":hex1_stage0",
        "DEFAULT": ":hex2_stage0",
    }),
    src = selects.apply(STAGE0_ARCH, lambda arch: "src/{0}/catm_{0}.{1}".format(
        arch,
        "hex1" if arch == "AArch64" else "hex2",
    )),
)

# The M2libc pieces every program links against: architecture definitions and
# libc in M1, and the ELF headers, debuggable or not.
filegroup(
    name = "m2libc_defs_libc",
    srcs = M2LIBC_DEFS_LIBC,
    copy = False,
)

filegroup(
    name = "m2libc_defs_libc_full",
    srcs = M2LIBC_DEFS_LIBC_FULL,
    copy = False,
)

filegroup(
    name = "m2libc_elf_header",
    srcs = M2LIBC_ELF_HEADER,
    copy = False,
)

filegroup(
    name = "m2libc_elf_header_debug",
    srcs = M2LIBC_ELF_HEADER_DEBUG,
    copy = False,
)

# The ELF headers stage0-posix ships itself, used until M2libc is reachable.
filegroup(
    name = "elf_header",
    srcs = select({
        "prelude//cpu/constraints:cpu[arm64]": ["src/AArch64/ELF-aarch64.hex2"],
        "prelude//cpu/constraints:cpu[x86_32]": ["src/x86/ELF-i386.hex2"],
        "prelude//cpu/constraints:cpu[x86_64]": ["src/AMD64/ELF-amd64.hex2"],
        "prelude//cpu/constraints:cpu[riscv64]": ["src/riscv64/ELF-riscv64.hex2"],
    }),
    copy = False,
)

hex2_binary(
    name = "m0_stage0",
    srcs = stage0_paths("{arch}/M0_{arch}.hex2"),
)

bootstrap_concat_file(
    name = "cc_stage0_riscv64.m1",
    catm = ":catm_stage0",
    srcs = [
        "src/riscv64/riscv64_defs.M1",
        "src/riscv64/cc_riscv64.M1",
    ],
)

bootstrap_m0_assemble(
    name = "cc_stage0_no_elf_header.hex2",
    assembler = ":m0_stage0",
    src = select({
        "prelude//cpu/constraints:cpu[arm64]": "src/AArch64/cc_aarch64.M1",
        "prelude//cpu/constraints:cpu[x86_32]": "src/x86/cc_x86.M1",
        "prelude//cpu/constraints:cpu[x86_64]": "src/AMD64/cc_amd64.M1",
        "prelude//cpu/constraints:cpu[riscv64]": ":cc_stage0_riscv64.m1",
    }),
)

hex2_binary(
    name = "cc_stage0",
    srcs = [":cc_stage0_no_elf_header.hex2"],
)

bootstrap_concat_file(
    name = "m2_stage0.c",
    catm = ":catm_stage0",
    srcs = BOOTSTRAP_C + [
        "src/M2-Planet/cc.h",
        "src/M2libc/bootstrappable.c",
        "src/M2-Planet/cc_globals.c",
        "src/M2-Planet/cc_reader.c",
        "src/M2-Planet/cc_strings.c",
        "src/M2-Planet/cc_types.c",
        "src/M2-Planet/cc_emit.c",
        "src/M2-Planet/cc_core.c",
        "src/M2-Planet/cc_macro.c",
        "src/M2-Planet/cc.c",
    ],
)

bootstrap_cc_compile(
    name = "m2_stage0_no_defs_no_libc.m1",
    compiler = ":cc_stage0",
    src = ":m2_stage0.c",
)

bootstrap_concat_file(
    name = "m2_stage0.m1",
    catm = ":catm_stage0",
    srcs = STAGE0_DEFS_LIBC + [":m2_stage0_no_defs_no_libc.m1"],
)

bootstrap_m0_assemble(
    name = "m2_stage0_no_elf_header.hex2",
    assembler = ":m0_stage0",
    src = ":m2_stage0.m1",
)

hex2_binary(
    name = "m2_stage0",
    srcs = [":m2_stage0_no_elf_header.hex2"],
)

m0_binary(
    name = "blood_elf_stage0",
    compiler = ":m2_stage0",
    assembler = ":m0_stage0",
    catm = ":catm_stage0",
    hex = ":hex2_stage0",
    bootstrap_mode = True,
    srcs = BOOTSTRAP_C + [
        "src/M2libc/bootstrappable.c",
        "src/mescc-tools/stringify.c",
        "src/mescc-tools/blood-elf.c",
    ],
)

m0_binary(
    name = "m1_stage0",
    compiler = ":m2_stage0",
    assembler = ":m0_stage0",
    catm = ":catm_stage0",
    hex = ":hex2_stage0",
    blood_elf = ":blood_elf_stage0",
    elf_header = ":m2libc_elf_header_debug",
    bootstrap_mode = True,
    debug = True,
    srcs = BOOTSTRAP_C + [
        "src/M2libc/bootstrappable.c",
        "src/mescc-tools/stringify.c",
        "src/mescc-tools/M1-macro.c",
    ],
)

m1_binary(
    name = "hex2_stage1",
    compiler = ":m2_stage0",
    assembler = ":m1_stage0",
    blood_elf = ":blood_elf_stage0",
    catm = ":catm_stage0",
    hex = ":hex2_stage0",
    srcs = HEX2_SOURCES,
)

m1_binary(
    name = "m1_stage1",
    compiler = ":m2_stage0",
    assembler = ":m1_stage0",
    blood_elf = ":blood_elf_stage0",
    linker = ":hex2_stage1",
    srcs = M1_SOURCES,
    visibility = ["PUBLIC"],
)

m1_binary(
    name = "hex2_stage2",
    compiler = ":m2_stage0",
    assembler = ":m1_stage1",
    blood_elf = ":blood_elf_stage0",
    linker = ":hex2_stage1",
    srcs = HEX2_SOURCES,
    visibility = ["PUBLIC"],
)

m1_binary(
    name = "kaem_stage0",
    compiler = ":m2_stage0",
    assembler = ":m1_stage1",
    blood_elf = ":blood_elf_stage0",
    linker = ":hex2_stage2",
    srcs = KAEM_SOURCES,
    visibility = ["PUBLIC"],
)

m1_binary(
    name = "m2_mesoplanet_stage0",
    compiler = ":m2_stage0",
    assembler = ":m1_stage1",
    blood_elf = ":blood_elf_stage0",
    linker = ":hex2_stage2",
    srcs = M2_MESOPLANET_SOURCES,
)

# The shipping blood-elf: debuggable, unlike the one M0 assembled.
m1_binary(
    name = "blood_elf_stage1",
    compiler = ":m2_stage0",
    assembler = ":m1_stage1",
    blood_elf = ":blood_elf_stage0",
    linker = ":hex2_stage2",
    srcs = BLOOD_ELF_SOURCES,
    visibility = ["PUBLIC"],
)

m1_binary(
    name = "get_machine_stage0",
    compiler = ":m2_stage0",
    assembler = ":m1_stage1",
    blood_elf = ":blood_elf_stage1",
    linker = ":hex2_stage2",
    srcs = GET_MACHINE_SOURCES,
)

m1_binary(
    name = "m2_stage1",
    compiler = ":m2_stage0",
    assembler = ":m1_stage1",
    blood_elf = ":blood_elf_stage1",
    linker = ":hex2_stage2",
    srcs = M2_PLANET_SOURCES,
    visibility = ["PUBLIC"],
)

filegroup_strip_prefix(
    name = "m2libc",
    srcs = glob(["src/M2libc/**"]),
    prefix = "src/M2libc/",
)

# What M2-Mesoplanet looks for in PATH when it drives a compile.
filegroup(
    name = "m2_mesoplanet_tools",
    srcs = {
        "M1": ":m1_stage1",
        "M2-Planet": ":m2_stage1",
        "blood-elf": ":blood_elf_stage1",
        "catm": ":catm_stage0",
        "hex2": ":hex2_stage2",
    },
    copy = False,
)

[
    bootstrap_m2_mesoplanet_compile(
        name = name,
        compiler = ":m2_mesoplanet_stage0",
        architecture = M2_ARCHITECTURE,
        m2libc = ":m2libc",
        src = "src/mescc-tools-extra/{}.c".format(source),
        tools = ":m2_mesoplanet_tools",
        visibility = ["PUBLIC"],
    )
    for name, source in MESCC_TOOLS_EXTRA.items()
]

# Everything stage0-posix ships, laid out the way its bin directory is.
filegroup(
    name = "bin",
    srcs = {
        "M1": ":m1_stage1",
        "M2-Mesoplanet": ":m2_mesoplanet_stage0",
        "M2-Planet": ":m2_stage1",
        "blood-elf": ":blood_elf_stage1",
        "get_machine": ":get_machine_stage0",
        "hex2": ":hex2_stage2",
        "kaem": ":kaem_stage0",
    } | {
        source: ":" + name
        for name, source in MESCC_TOOLS_EXTRA.items()
    },
    copy = False,
    visibility = ["PUBLIC"],
)

# Checks the binaries against the hashes stage0-posix publishes for them. It can
# only run once sha256sum itself is built, so everything below it, seed
# included, is verified after the fact.
bootstrap_sha256_check(
    name = "check",
    answers = ANSWERS,
    prefix = ANSWERS_PREFIX,
    replace = ":replace_stage0",
    sha256sum = ":sha256sum_stage0",
    tools = ":bin",
)
