    name = "get_machine_stage0",
    compiler = ":m2_stage0",
    assembler = ":m1_stage1",
    blood_elf = ":blood_elf_stage1",
    linker = ":hex2_stage2",
    srcs = GET_MACHINE_SOURCES,
)

bootstrap_m1_program(
    name = "m2_stage1",
    compiler = ":m2_stage0",
    assembler = ":m1_stage1",
    blood_elf = ":blood_elf_stage1",
    linker = ":hex2_stage2",
    srcs = M2_PLANET_SOURCES,
    visibility = ["PUBLIC"],
)

filegroup_strip_prefix(
    name = "m2libc",
    srcs = glob(["src/M2libc/**"]),
    prefix = "src/M2libc/",
)

# What M2-Mesoplanet looks for in PATH when it drives a compile.
filegroup(
    name = "m2_mesoplanet_tools",
    srcs = {
        "M1": ":m1_stage1",
        "M2-Planet": ":m2_stage1",
        "blood-elf": ":blood_elf_stage1",
        "catm": ":catm_stage0",
        "hex2": ":hex2_stage2",
    },
    copy = False,
)

[
    bootstrap_m2_mesoplanet_compile(
        name = name,
        compiler = ":m2_mesoplanet_stage0",
        architecture = M2_ARCHITECTURE,
        m2libc = ":m2libc",
        src = "src/mescc-tools-extra/{}.c".format(source),
        tools = ":m2_mesoplanet_tools",
        visibility = ["PUBLIC"],
    )
    for name, source in MESCC_TOOLS_EXTRA.items()
]

# Everything stage0-posix ships, laid out the way its bin directory is.
filegroup(
    name = "bin",
    srcs = {
        "M1": ":m1_stage1",
        "M2-Mesoplanet": ":m2_mesoplanet_stage0",
        "M2-Planet": ":m2_stage1",
        "blood-elf": ":blood_elf_stage1",
        "get_machine": ":get_machine_stage0",
        "hex2": ":hex2_stage2",
        "kaem": ":kaem_stage0",
    } | {
        source: ":" + name
        for name, source in MESCC_TOOLS_EXTRA.items()
    },
    copy = False,
    visibility = ["PUBLIC"],
)

# Checks the binaries against the hashes stage0-posix publishes for them. It can
# only run once sha256sum itself is built, so everything below it, seed
# included, is verified after the fact.
bootstrap_sha256_check(
    name = "check",
    answers = ANSWERS,
    prefix = ANSWERS_PREFIX,
    replace = ":replace_stage0",
    sha256sum = ":sha256sum_stage0",
    tools = ":bin",
)
